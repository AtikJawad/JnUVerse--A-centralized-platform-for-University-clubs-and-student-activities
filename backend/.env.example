# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: hosted Supabase PostgreSQL ---
# Get these from your Supabase project settings (Project Settings -> Database).
# Never commit real values.
DB_NAME=postgres
DB_USER=your-supabase-db-user
DB_PASSWORD=your-supabase-db-password
DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# --- CORS: origins allowed to call this API (the React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Image uploads (club logos / event banners) ---
# Local dev: leave USE_SUPABASE_STORAGE off; files go to backend/media/ and are served by runserver when DEBUG=True.
PUBLIC_BASE_URL=http://localhost:8000
USE_SUPABASE_STORAGE=False
# Production (Render) - Supabase Storage via S3 API. Create a PUBLIC bucket first (Storage -> New bucket),
# then Storage -> S3 Connection to get the endpoint and generate access keys. Never commit real values.
SUPABASE_S3_BUCKET=jnuverse-media
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<region shown on the S3 Connection page>
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# Public base for reading files (domain + path, no https://):
SUPABASE_PUBLIC_MEDIA_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/jnuverse-media
# Optional limits (bytes / pixels): CLUB_LOGO_MAX_BYTES=2097152  EVENT_BANNER_MAX_BYTES=5242880  IMAGE_MAX_SIDE=4096
