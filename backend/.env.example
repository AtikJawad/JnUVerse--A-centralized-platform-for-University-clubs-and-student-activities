# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- Django core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: hosted Supabase PostgreSQL ---
# Get these from your Supabase project settings (Project Settings -> Database).
# Never commit real values.
DB_NAME=postgres
DB_USER=your-supabase-db-user
DB_PASSWORD=your-supabase-db-password
DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# --- CORS: origins allowed to call this API (the React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
