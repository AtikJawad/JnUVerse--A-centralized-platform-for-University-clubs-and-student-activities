# Copy this file to frontend/.env and adjust if needed.
# frontend/.env is git-ignored and must never be committed with real secrets.
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# Never put database credentials or server-only secrets here — the React
# frontend must never talk to PostgreSQL/Supabase directly, only to the
# Django/DRF API below.

VITE_API_BASE_URL=http://127.0.0.1:8000
